# Example environment file for running the backend services *outside* Docker.
#
# When you start the stack with `docker compose up`, none of these values
# are read from this file — `docker-compose.yml` provides them inline.
# This template is only relevant if you want to run a service directly
# (e.g. `./gradlew :api-gateway:run`) on the host machine.
#
# To use it: copy this file to `.env`, adjust as needed, then `source .env`
# in the shell where you launch the service. The real `.env` is gitignored.

PORT=8080

# JWT signing — for local development only. In production, set the actual
# RSA private/public PEM via JWT_RSA_PRIVATE_PEM / JWT_RSA_PUBLIC_PEM, or
# leave JWT_DEV_ALLOW_GENERATE_KEYS=true to generate ephemeral keys at
# auth-service startup (tokens will not survive a restart).
JWT_SECRET=dev-secret
JWT_DEV_ALLOW_GENERATE_KEYS=true

# Service URLs for the gateway when running services on localhost.
# In Docker these are replaced by service-name URLs (e.g. http://auth-service:8081).
AUTH_BASE_URL=http://localhost:8081
REGISTRY_BASE_URL=http://localhost:8082
EXPLORER_BASE_URL=http://localhost:8083
PSBT_BASE_URL=http://localhost:8085
BLOCKCHAIN_BASE_URL=http://localhost:8086
PRICE_BASE_URL=http://localhost:8087
