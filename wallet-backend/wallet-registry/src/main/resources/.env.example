# Example environment file for running wallet-registry *outside* Docker.
#
# When the service runs in `docker compose up`, these values are provided
# by `docker-compose.yml` (with the Postgres host set to the service name
# `postgres` instead of `localhost`). This file is only used when launching
# the service directly on the host machine.
#
# To use: copy to `.env` and adjust. The real `.env` is gitignored.

REGISTRY_DB_URL=jdbc:postgresql://localhost:5432/wallet_registry
REGISTRY_DB_USER=wallet
REGISTRY_DB_PASSWORD=wallet

# Allow auth-service to generate ephemeral RSA keys at startup if no
# JWT_RSA_PRIVATE_PEM/JWT_RSA_PUBLIC_PEM are provided. Dev only.
JWT_DEV_ALLOW_GENERATE_KEYS=true
