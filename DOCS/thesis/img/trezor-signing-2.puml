@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 30
skinparam ParticipantPadding 10
skinparam BoxPadding 8
skinparam sequenceMessageAlign center

actor "Uživatel" as user
participant "Android\naplikace" as app
participant "API\nGateway" as gw
participant "psbt-service" as psbt
participant "Trezor Suite\nMobile" as tsm
participant "Trezor" as hw

app -> tsm : deeplink: signTransaction\n(vstupy, výstupy, derivační cesty)
activate tsm
tsm -> hw : předá transakci
activate hw
hw -> user : zobrazí detaily
user -> hw : fyzicky potvrdí
hw --> tsm : podpisy
deactivate hw
tsm --> app : callback URL\n(signatures, serialized_tx)
deactivate tsm

alt singlesig
    app -> gw : POST /psbt/{id}/broadcast-raw\n(serialized_tx)
    activate gw
    gw -> psbt : broadcast
    activate psbt
    psbt --> gw : txid
    deactivate psbt
    gw --> app : txid
    deactivate gw
else multisig
    app -> gw : POST /psbt/{id}/sign-trezor\n(signatures, cosignerIndex)
    activate gw
    gw -> psbt : přidej podpisy
    activate psbt
    psbt -> psbt : BIP-67 řazení\n+ vložení do PSBT\n+ current_sigs++
    psbt --> gw : aktualizovaný stav PSBT\n(current_sigs / required_sigs)
    deactivate psbt
    gw --> app : stav PSBT
    deactivate gw
    alt current_sigs == required_sigs
        app -> app : na detailu PSBT\nzobrazí \"Broadcast Transaction\"
        user -> app : klikne \"Broadcast\"
        app -> gw : POST /psbt/{id}/broadcast-raw\n(serialized_tx)
        activate gw
        gw -> psbt : broadcast
        activate psbt
        psbt --> gw : txid
        deactivate psbt
        gw --> app : txid
        deactivate gw
    else čeká na další cosignery
        app -> app : zobrazí \"1 z M podpisů\"
    end
end

@enduml
