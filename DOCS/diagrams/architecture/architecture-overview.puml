@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam RectangleFontSize 13

left to right direction

rectangle "**Android App**" as App
rectangle "**Trezor**" as Trezor
cloud "**Blockstream Esplora**" as Esplora
cloud "**CoinGecko**" as CoinGecko

rectangle "**Backend (Docker Compose)**" as Backend {
  rectangle "**API Gateway** :8080" as ApiGw
  rectangle "**Auth Service** :8081" as AuthSvc
  rectangle "**Wallet Registry** :8082" as WalletReg
  rectangle "**Explorer Service** :8083" as Explorer
  rectangle "**PSBT Service** :8085" as PsbtSvc
  rectangle "**Blockchain Service** :8086" as BlockchainSvc
  rectangle "**Price Service** :8087" as PriceSvc
  database "**PostgreSQL** :5432" as PG
}

App -down-> ApiGw
App .left[dotted].. Trezor : USB

ApiGw --> AuthSvc
ApiGw --> WalletReg
ApiGw --> Explorer
ApiGw --> PsbtSvc
ApiGw --> BlockchainSvc
ApiGw --> PriceSvc

Explorer -[#F59E0B]-> WalletReg
Explorer -[#F59E0B]-> BlockchainSvc

PsbtSvc -[#F59E0B]-> WalletReg
PsbtSvc -[#F59E0B]-> BlockchainSvc

BlockchainSvc -right[#EF4444,dashed]-> Esplora
PriceSvc -right[#EF4444,dashed]-> CoinGecko

WalletReg -down[#10B981]-> PG
PsbtSvc -down[#10B981]-> PG

legend left
|= Šipka |= Význam |
| <color:#000000>■ černá</color> | Gateway → služba |
| <color:#F59E0B>■ oranžová</color> | Inter-service |
| <color:#EF4444>■ červená čárkovaná</color> | Externí API |
| <color:#10B981>■ zelená</color> | Databáze |
endlegend
@enduml
