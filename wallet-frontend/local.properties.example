# Copy this file to local.properties (gitignored) and fill in two values:
#
#   sdk.dir              - path to your Android SDK (Android Studio sets this
#                          automatically on first project open)
#   api.gateway.base.url - URL of the backend API gateway
#
# See README.md for how to pick the right host (emulator / LAN / Tailscale).

sdk.dir=/path/to/Android/Sdk
api.gateway.base.url=http://100.91.223.40:8080/api/v1
