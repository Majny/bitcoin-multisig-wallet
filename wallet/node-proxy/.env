# RPi → RPC do Core lokálně
RPC_URL=http://127.0.0.1:8332/

# Volitelné: pokud nenecháš cookie, použij rpcauth na Core a odkomentuj:
# RPC_USER=backend
# RPC_PASS=REPLACE_WITH_STRONG_PASSWORD

# API key pro přístup z tailnetu
API_KEY=dev-local-key

# Server bind (doporučení: TS IP; default 0.0.0.0)
BIND_HOST=0.0.0.0
PORT=8088

# Timeouts & retries
UPSTREAM_CONNECT_TIMEOUT_MS=4000
UPSTREAM_SOCKET_TIMEOUT_MS=8000
UPSTREAM_RETRIES=2
